# ── Neo4j Configuration ──────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Redis Configuration ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google Gemini (LLM Provider) ────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-pro

# ── PubChem API ──────────────────────────────────────────────────────────────
PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# ── OpenAlex API ─────────────────────────────────────────────────────────────
OPENALEX_API_BASE=https://api.openalex.org
OPENALEX_EMAIL=

# ── NCBI (PubMed / Taxonomy) ────────────────────────────────────────────────
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_EUTILS_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# ── Semantic Scholar ─────────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── ChEMBL API ───────────────────────────────────────────────────────────────
CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data

# ── EPA INERTFinder ──────────────────────────────────────────────────────────
EPA_INERT_API_BASE=

# ── USPTO Patents ────────────────────────────────────────────────────────────
USPTO_API_BASE=https://api.patentsview.org

# ── Celery (Task Queue) ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Rate Limits (requests per second) ────────────────────────────────────────
PUBCHEM_RATE_LIMIT=5.0
OPENALEX_RATE_LIMIT=10.0
PUBMED_RATE_LIMIT=3.0
CHEMBL_RATE_LIMIT=15.0
NCBI_RATE_LIMIT=3.0

# ── Snowflake (Enterprise Patent C-RAG) ─────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=FORMULA_APP_WH
SNOWFLAKE_DATABASE=FORMULA_KNOWLEDGE_DB
SNOWFLAKE_SCHEMA=GLOBAL_PATENTS
