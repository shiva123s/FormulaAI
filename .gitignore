# FormulaAI — Root .gitignore

# ── Python & Bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
backend/venv/
backend/.venv/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env*
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Node / Frontend / Build Artifacts ──────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Generated Files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
